{
  "name": "gay-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:smoke": "node scripts/test-smoke.mjs",
    "test:e2e-smoke": "node scripts/test-e2e-smoke.mjs",
    "test:event-entity-e2e": "node scripts/test-event-entity-e2e.mjs",
    "test:internal-link-depth": "node scripts/test-internal-link-depth.mjs",
    "test:discovery-indexing": "node scripts/test-discovery-indexing.mjs",
    "test:entity-consistency": "node scripts/test-entity-consistency.mjs",
    "test:seo-telemetry": "node scripts/test-seo-telemetry.mjs",
    "test:indexnow": "node scripts/test-indexnow.mjs",
    "test:seo-phase1": "node scripts/test-seo-phase1.mjs",
    "test:seo-phase2": "node scripts/test-seo-phase2.mjs",
    "test:city-hero-copy": "node scripts/test-city-hero-copy.mjs",
    "test:gsc-indexing": "node scripts/test-gsc-indexing-regressions.mjs",
    "test:image-seo": "node scripts/test-image-seo.mjs",
    "test:traffic-analytics": "node scripts/test-traffic-analytics.mjs",
    "test:nightlife-index": "node scripts/test-nightlife-index.mjs",
    "audit:nightlife-index": "node --use-system-ca --env-file=.env.local scripts/audit-nightlife-index.mjs",
    "test:safety-index": "node scripts/test-safety-index.mjs",
    "test:global-queer-index": "node scripts/test-global-queer-index.mjs",
    "test:report-lists": "node scripts/test-report-lists.mjs",
    "test:qari-phase1": "node scripts/test-qari-phase1.mjs",
    "test:search-trust": "node scripts/test-search-trust.mjs",
    "audit:safety-index": "node --use-system-ca --env-file=.env.local scripts/audit-safety-index.mjs",
    "seo:ba4-validate": "node scripts/seo-ba4-validate.mjs --csv docs/templates/seo-ba4-kpi-tracker.csv",
    "seo:ba4-priority": "npm run seo:ba4-validate && node scripts/seo-ba4-priority.mjs --csv docs/templates/seo-ba4-kpi-tracker.csv --top 10",
    "seo:ba4-weekly-report": "npm run seo:ba4-validate && node scripts/seo-ba4-priority.mjs --csv docs/templates/seo-ba4-kpi-tracker.csv --top 10 --out reports/seo-ba4-priority-latest.md --weekly-report-out reports/seo-ba4-weekly-report-latest.md",
    "seo:ba4-sla-queue": "npm run seo:ba4-validate && node scripts/seo-ba4-sla-queue.mjs --csv docs/templates/seo-ba4-kpi-tracker.csv --top 25 --out reports/seo-ba4-sla-queue-latest.md",
    "seo:health-report": "node scripts/seo-health-report.mjs",
    "seo:health-weekly-report": "node scripts/seo-health-weekly-report.mjs --out reports/seo-health-weekly-latest.md",
    "test:favorites-helpers": "node scripts/test-favorites-helpers.mjs",
    "test:regressions": "node scripts/test-regressions.mjs",
    "test:map-guard-smoke": "node scripts/test-map-guard-smoke.mjs",
    "verify:release": "npm run lint && npm run test:search-trust && npm run build && npm run test:smoke && npm run test:e2e-smoke && npm run test:regressions && npm run test:map-guard-smoke && npm run test:internal-link-depth && npm run test:discovery-indexing && npm run test:entity-consistency && npm run test:seo-telemetry && npm run test:indexnow && npm run test:seo-phase1 && npm run analyze:bundle && node scripts/verify-bundle-budget.mjs && node scripts/verify-seo-gate.mjs && npm run seo:health-report && npm run seo:health-weekly-report",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "push:safe": "npm run verify:release && git push",
    "setup:githooks": "git config core.hooksPath .githooks",
    "backfill:place-locations": "node scripts/backfill-place-locations.mjs",
    "audit:place-coordinates": "node --use-system-ca --env-file=.env.local scripts/audit-place-coordinates.mjs",
    "fix:reviewed-place-coordinates": "node --use-system-ca --env-file=.env.local scripts/apply-reviewed-place-coordinate-fixes.mjs",
    "fix:safe-place-coordinate-audit": "node --use-system-ca --env-file=.env.local scripts/apply-safe-place-coordinate-audit.mjs",
    "seed:city-reviews": "node scripts/seed-city-reviews.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.48.0",
    "@supabase/supabase-js": "^2.100.1",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.7.0",
    "mapbox-gl": "^2.15.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "playwright": "^1.60.0",
    "tailwindcss": "^4"
  },
  "engines": {
    "node": "22.x"
  }
}
